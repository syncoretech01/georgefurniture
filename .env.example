# ---------------------------------------------------------------------------
# George's Furniture Assembly & Handyman Services — environment variables
# Copy to .env.local and fill in. None are required for the site to run.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://georgeshandyman.com

# --- Form delivery (NOT wired yet — see src/app/actions/inquiry.ts) ----------
# Option A: Resend (https://resend.com) — uncomment the block in inquiry.ts
# RESEND_API_KEY=re_xxxxxxxxx
# INQUIRY_TO_EMAIL=floridaboygeorge@gmail.com
# INQUIRY_FROM_EMAIL=quotes@georgeshandyman.com

# Option B: Formspree / Web3Forms endpoint
# INQUIRY_WEBHOOK_URL=https://formspree.io/f/xxxxxxxx
